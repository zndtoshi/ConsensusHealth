DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/consensushealth
PORT=8787
APP_URL=http://localhost:8787
APP_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# Must be a strong random value ≥32 characters in production (not a placeholder).
SESSION_SECRET=change_me_long_random_at_least_32_chars
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
TWITTERAPI_IO_KEY=
SESSION_TTL_DAYS=30
# Operator-declared backup retention policy (days) for Privacy copy / public-config.
# This is the policy you publish for this deployment (e.g. how long you keep provider
# Postgres snapshots), not a Render SLA invention. Default 7.
BACKUP_RETENTION_DAYS=7
# Canonical public contact (required valid email in production). Exposed to the
# built UI via GET /api/public-config (same value as Privacy page contact).
CONTACT_EMAIL=
# PRIVACY_CONTACT_EMAIL=   # fallback if CONTACT_EMAIL unset
#
# Optional build-time frontend override (prefer runtime /api/public-config):
# VITE_CONTACT_EMAIL=you@example.com
# VITE_API_BASE=   (empty for same-origin; http://localhost:8787 in split-dev)
#
# Client IP / proxy topology (pick exactly one production mode):
# TRUST_PROXY_MODE=render_direct
#   Trust a single Render reverse-proxy hop (trust proxy = 1). Do not enable
#   CF-Connecting-IP. Suitable when visitors hit Render without Cloudflare IP trust.
# TRUST_PROXY_MODE=cloudflare_origin_lock
#   Cloudflare must add header CF_ORIGIN_SECRET_HEADER (default X-Origin-Verify)
#   with value CF_ORIGIN_SECRET (≥32 chars). Origin rejects other traffic with 403
#   (except /api/health and /api/ready). Only then is CF-Connecting-IP trusted.
# CF_ORIGIN_SECRET=
# CF_ORIGIN_SECRET_HEADER=x-origin-verify
#
# E2E / mock OAuth — only honored when NODE_ENV=test AND CONSENSUSHEALTH_E2E=1.
# Production refuses to start if any of these are set. Never enable on Render.
# NODE_ENV=test
# CONSENSUSHEALTH_E2E=1
# X_OAUTH_MOCK=1
# E2E_SERVE_DIST=1
# FORCE_LISTEN=1
# HELMET_PROD=1
# X_OAUTH_MOCK_USER_ID=
# X_OAUTH_MOCK_HANDLE=
# X_OAUTH_MOCK_NAME=
#
# Rate limits (see server/src/security/rateLimits.ts): general API 120/min; auth 20/15m;
# stance + explanation writes 30/15m; account deletion 10/15m. In-memory store is fine
# for a single instance; use a shared store if you scale out.
#
# Account deletion: POST /api/me/delete  body: { "confirm_handle": "<handle>" }
# (authenticated session required; confirm_handle must match the signed-in handle).
#
# Optional error monitoring (install @sentry/node in production if used):
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
